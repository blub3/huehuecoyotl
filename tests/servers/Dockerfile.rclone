# WebDAV and SFTP from a read-only rclone, FTP from vsftpd (all Ubuntu packages).
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends rclone vsftpd ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -M -d /media -s /bin/sh coyotl && echo 'coyotl:coyotl-test' | chpasswd && mkdir -p /var/run/vsftpd/empty
COPY vsftpd.conf /etc/vsftpd.conf
EXPOSE 8080 2022 21 30000-30010
CMD ["sh", "-c", "rclone serve webdav /media --addr :8080 --user coyotl --pass coyotl-test --read-only & rclone serve sftp /media --addr :2022 --user coyotl --pass coyotl-test --authorized-keys /keys/authorized_keys --read-only & /usr/sbin/vsftpd /etc/vsftpd.conf & wait"]
