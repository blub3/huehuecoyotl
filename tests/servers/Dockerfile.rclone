# WebDAV and SFTP from a read-only rclone, FTP from vsftpd (all Ubuntu packages).
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends rclone vsftpd ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -M -d /media -s /bin/sh coyotl && echo 'coyotl:coyotl-test' | chpasswd && mkdir -p /var/run/vsftpd/empty
COPY vsftpd.conf vsftpd-write.conf /etc/
EXPOSE 8080 8081 2022 2023 21 2121 30000-30020
CMD ["sh", "-c", "rclone serve webdav /media --addr :8080 --user coyotl --pass coyotl-test --read-only & rclone serve sftp /media --addr :2022 --user coyotl --pass coyotl-test --authorized-keys /keys/authorized_keys --read-only & rclone serve webdav /write --addr :8081 --user coyotl --pass coyotl-test & rclone serve sftp /write --addr :2023 --user coyotl --pass coyotl-test & /usr/sbin/vsftpd /etc/vsftpd.conf & /usr/sbin/vsftpd /etc/vsftpd-write.conf & wait"]
