import QtQuick

// The Huehuecoyotl logo (assets/logo; sizes generated by tools/make-icons.py). Loaded from the
// 512 px icon and scaled once to the displayed size times the screen's scale factor, so it stays
// sharp at 100, 150 and 200 %.
Image {
    id: logo
    property real size: 34
    width: size
    height: size
    source: "qrc:/icons/512x512/apps/io.github.blub3.Huehuecoyotl.png"
    sourceSize.width: Math.ceil(size * Screen.devicePixelRatio)
    sourceSize.height: Math.ceil(size * Screen.devicePixelRatio)
    fillMode: Image.PreserveAspectFit
    smooth: true
    mipmap: true
    asynchronous: false
    Accessible.role: Accessible.Graphic
    Accessible.name: qsTr("Huehuecoyotl logo")
}
